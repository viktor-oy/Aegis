aegis_env = os.getenv('AEGIS_ENV', 'local')

allow_k8s_contexts(['kind-aegis', 'kind-aegis-intg-test', 'kind-aegis-scenario'])
if aegis_env == 'intg-test':
    k8s_context('kind-aegis-intg-test')
elif aegis_env == 'scenario':
    k8s_context('kind-aegis-scenario')
else:
    pass

port_map_data = decode_json(str(read_file('scripts/ports.json')))

# The JSON structure groups ports by environment (local, intg-test, scenario)
# but Tilt expects string values for port forwards in the form 'local:remote'
# So we need to reconstruct the format Tiltfile.infra expects for backwards compatibility,
# or we can just reconstruct the infra_ports dict here dynamically.

raw_ports = port_map_data.get(aegis_env, port_map_data['local'])
infra_ports = {
    'kafka_bootstrap': str(raw_ports['kafka_bootstrap']),
    'kafka_brokers': [str(p) for p in raw_ports['kafka_brokers']],
    'etcd': [str(raw_ports['etcd']) + ":2379"],
    'llm': [str(raw_ports['llm']) + ":11434"],
    'mailpit': [str(raw_ports['mailpit_smtp']) + ":1025", str(raw_ports['mailpit_http']) + ":8025"]
}

# Build the AI Server — model is parameterized via OLLAMA_MODEL env var / build arg (default: qwen2.5:0.5b).
# Can be overridden via environment variable (e.g. `OLLAMA_MODEL=llama3.2:1b tilt up`) or by manually editing this file.
# On Apple Silicon, Ollama automatically uses Metal GPU acceleration.
#
# Uses custom_build with a fixed tag to avoid Tilt's per-session hash churn.
# The build script checks if the image already exists in the local registry before building,
# preventing unnecessary ~350MB model re-downloads when nothing in the Dockerfile has changed.
ollama_model = os.getenv('OLLAMA_MODEL', 'qwen2.5:0.5b')
custom_build(
    'aegis-llm',
    """set -e;
TAG="localhost:5001/aegis-llm:stable-%s";
if docker manifest inspect "$TAG" > /dev/null 2>&1; then
  echo "[aegis-llm] Image already exists in registry, skipping build.";
  docker tag "$TAG" "$EXPECTED_REF";
  docker push "$EXPECTED_REF";
else
  echo "[aegis-llm] Building image...";
  docker build -t "$EXPECTED_REF" -t "$TAG" infra/docker/llm --build-arg OLLAMA_MODEL=%s;
  docker push "$EXPECTED_REF";
  docker push "$TAG";
fi""" % (ollama_model.replace(':', '-'), ollama_model),
    deps=['infra/docker/llm/Dockerfile', 'infra/docker/llm/entrypoint.sh'],
    skips_local_docker=False,
)

# Run helm dependency update only when Chart.yaml changes (covers fresh setup and version bumps
# without blocking every Tiltfile reload on a slow network round-trip).
local_resource(
    'helm-dep-update',
    cmd='helm dependency update infra/helm/aegis',
    trigger_mode=TRIGGER_MODE_AUTO,
    deps=['infra/helm/aegis/Chart.yaml'],
    labels=['infra'],
)

# Tell Tilt to watch these directories so it automatically reloads on changes
watch_file('infra/kustomize')
watch_file('infra/helm')

# Apply all Kustomize base infra resources (Kafka, Etcd, PostgreSQL, LLM))
default_overlay = 'infra/kustomize/overlays/' + aegis_env if aegis_env in ['local', 'intg-test'] else 'infra/kustomize/overlays/local'
kustomize_dir = os.getenv('AEGIS_KUSTOMIZE_OVERLAY', default_overlay)
watch_file(kustomize_dir)
k8s_yaml(local('kustomize build --load-restrictor LoadRestrictionsNone --enable-helm ' + kustomize_dir))

k8s_resource('aegis-kafka-controller', labels=['infra'])

kube_context = 'kind-aegis'
if aegis_env == 'intg-test':
    kube_context = 'kind-aegis-intg-test'
elif aegis_env == 'scenario':
    kube_context = 'kind-aegis-scenario'

# Port-forward individual Kafka external services so local integration tests can reach every broker.
local_resource(
    'kafka-pf-bootstrap',
    serve_cmd='./infra/scripts/resilient-port-forward.sh svc/aegis-kafka-controller-0-external aegis-system ' + str(infra_ports["kafka_bootstrap"]) + ':9094 ' + kube_context,
    resource_deps=['aegis-kafka-controller'],
    labels=['infra'],
)
local_resource(
    'kafka-pf-0',
    serve_cmd='./infra/scripts/resilient-port-forward.sh svc/aegis-kafka-controller-0-external aegis-system ' + str(infra_ports["kafka_brokers"][0]) + ':9094 ' + kube_context,
    resource_deps=['aegis-kafka-controller'],
    labels=['infra'],
)
local_resource(
    'kafka-pf-1',
    serve_cmd='./infra/scripts/resilient-port-forward.sh svc/aegis-kafka-controller-1-external aegis-system ' + str(infra_ports["kafka_brokers"][1]) + ':9094 ' + kube_context,
    resource_deps=['aegis-kafka-controller'],
    labels=['infra'],
)
local_resource(
    'kafka-pf-2',
    serve_cmd='./infra/scripts/resilient-port-forward.sh svc/aegis-kafka-controller-2-external aegis-system ' + str(infra_ports["kafka_brokers"][2]) + ':9094 ' + kube_context,
    resource_deps=['aegis-kafka-controller'],
    labels=['infra'],
)
# Automatically initialize Kafka topics once the Kafka controller is up

local_resource(
    'init-kafka',
    cmd='make init-kafka',
    env={'AEGIS_KUBE_CONTEXT': kube_context, 'AEGIS_KAFKA_BROKER_ADDR': '127.0.0.1:' + str(infra_ports['kafka_bootstrap'])},
    resource_deps=['aegis-kafka-controller', 'kafka-pf-bootstrap', 'kafka-pf-0', 'kafka-pf-1', 'kafka-pf-2'],
    labels=['infra'],
)
    
k8s_resource('aegis-etcd', labels=['infra'], port_forwards=infra_ports['etcd'])
k8s_resource('aegis-llm', labels=['infra'], port_forwards=infra_ports['llm'])
k8s_resource('aegis-mailpit', labels=['infra'], port_forwards=infra_ports['mailpit'])
