{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Integration Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "--no-cov",
                "tests/integration/composer/test_composer_integration.py"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}