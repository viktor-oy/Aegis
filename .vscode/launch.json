{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Composer Integration Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "--no-cov",
                "tests/integration/composer/test_composer_integration.py"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug CP Server Intg Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/services/control-plane/internal/server",
            "buildFlags": "-tags=integration",
            "args": [
                "-test.v",
                "-test.run", "^TestIntegration_"
            ]
        },
        {
            "name": "Debug CP Incident Intg Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/services/control-plane/internal/incident",
            "buildFlags": "-tags=integration",
            "args": [
                "-test.v",
                "-test.run", "^TestIntegration_"
            ]
        }
    ]
}